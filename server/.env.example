# Copy to .env — every value has a sensible default for local development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/projectboard
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=8h
CLIENT_ORIGIN=http://localhost:5173

# Timezone used for reward streaks and on-time checks
TIMEZONE=Asia/Kolkata

# AI Project Assistant (get a key at https://platform.openai.com/api-keys). Keep it here, never in the client code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
