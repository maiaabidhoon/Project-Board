# Copy to .env — every value has a sensible default for local development
PORT=4000
# Local MongoDB, or a MongoDB Atlas string (mongodb+srv://USER:PASSWORD@cluster.xxxxx.mongodb.net/projectboard).
# Put real passwords ONLY in server/.env, never in source code.
MONGODB_URI=mongodb://127.0.0.1:27017/projectboard
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES=8h
# Where the web app is served from. Several origins can be listed, separated by commas.
# (In development any localhost / 127.0.0.1 port is accepted automatically.)
CLIENT_ORIGIN=http://localhost:5173

# Timezone used for reward streaks and on-time checks
TIMEZONE=Asia/Kolkata

# AI Project Assistant (get a key at https://platform.openai.com/api-keys). Keep it here, never in the client code.
# Leave empty to use the built-in "basic mode" (answers from your project data, free). It is also the automatic fallback if OpenAI is down.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
